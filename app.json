{
  "expo": {
    "name": "YT Podcast",
    "slug": "youtube-podcast-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-dev-client"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sbc.ytpodcast",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    }
  }
}
